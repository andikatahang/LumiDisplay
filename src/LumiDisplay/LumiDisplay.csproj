<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>lumidisplay.ico</ApplicationIcon>
    <AssemblyName>LumiDisplay</AssemblyName>
    <RootNamespace>LumiDisplay</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>LumiDisplay - Intelligent display brightness, contrast, and audio volume control for Windows</Description>
    <Version>1.2.0</Version>
    <Product>LumiDisplay</Product>
    <Authors>andikatahang</Authors>
    <Copyright>Copyright © 2026 andikatahang</Copyright>
    <RepositoryUrl>https://github.com/andikatahang/LumiDisplay</RepositoryUrl>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="lumidisplay.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Inter UI font (SIL Open Font License, see Fonts/Inter-OFL.txt), embedded in the exe -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\Inter-Regular.ttf" LogicalName="LumiDisplay.Fonts.Inter-Regular.ttf" />
    <EmbeddedResource Include="Fonts\Inter-Medium.ttf" LogicalName="LumiDisplay.Fonts.Inter-Medium.ttf" />
    <EmbeddedResource Include="Fonts\Inter-SemiBold.ttf" LogicalName="LumiDisplay.Fonts.Inter-SemiBold.ttf" />
    <None Include="Fonts\Inter-OFL.txt" />
    <!-- Settings window background (black and white) -->
    <EmbeddedResource Include="Assets\background.jpg" LogicalName="LumiDisplay.Assets.background.jpg" />
  </ItemGroup>

</Project>
